# Credenciales de la app de Spotify (Developer Dashboard -> tu app -> Settings).
# Copia este archivo a .env y completa los valores. .env NO se sube a git.
# Necesario solo para la skill de Spotify; el resto del agente anda sin esto.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Busqueda en internet (skill buscar_en_internet). Free tier en https://tavily.com
# Sin esto, buscar_en_internet cae directo a ChatGPT.
TAVILY_API_KEY=
